\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Baseline mediation results}{16}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pathway-mediation shares for each substrate-outcome pair, with 95\% percentile-bootstrap CIs. Vertical reference lines at 0 (no mediation) and 1 (full mediation). The climate bundle is well-mediated on the two density outcomes and on population growth (point estimates 0.75, 0.17, 0.92 respectively). Ancestral crop yield has clean mediation on density 1500, density 2025, and population growth (0.24, 0.10, 0.29). The remaining suppressor structure is concentrated in the heterozygosity and pandemic rows and is largely absorbed by continent fixed effects (Section~\ref {sec:mediation-continentfe}).}}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:mediation-baseline}{{4}{17}{Pathway-mediation shares for each substrate-outcome pair, with 95\% percentile-bootstrap CIs. Vertical reference lines at 0 (no mediation) and 1 (full mediation). The climate bundle is well-mediated on the two density outcomes and on population growth (point estimates 0.75, 0.17, 0.92 respectively). Ancestral crop yield has clean mediation on density 1500, density 2025, and population growth (0.24, 0.10, 0.29). The remaining suppressor structure is concentrated in the heterozygosity and pandemic rows and is largely absorbed by continent fixed effects (Section~\ref {sec:mediation-continentfe})}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Mediation-share point estimates with 95\% percentile-bootstrap CIs. Climate bundle uses partial-R\textsuperscript  {2} mediation share; H, A, $\Pi $ use $\beta $-attenuation. Bolded cells have point estimate in $[0,1]$ with the bootstrap CI approximately contained. See Section~\ref {sec:mediation-continentfe} for the continent-fixed-effects variant.}}{17}{table.caption.11}\protected@file@percent }
\newlabel{tab:mediation}{{7}{17}{Mediation-share point estimates with 95\% percentile-bootstrap CIs. Climate bundle uses partial-R\textsuperscript {2} mediation share; H, A, $\Pi $ use $\beta $-attenuation. Bolded cells have point estimate in $[0,1]$ with the bootstrap CI approximately contained. See Section~\ref {sec:mediation-continentfe} for the continent-fixed-effects variant}{table.caption.11}{}}
