\@writefile{toc}{\contentsline {paragraph}{Extension: state-history and SSA-ancestry partialling.}{32}{section*.21}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces DARC coefficient on log GDPpc 2015 under sample restriction and progressive control additions. The 154-country baseline loading is negative ($-2.65$) but is carried by the 18 countries---predominantly Sub-Saharan African and Gulf states---that lack Bockstette-Putterman state-history coverage. Restricting to the 136 countries for which state history is observed already flips DARC to $+0.62$ ($p=0.67$) \emph  {before} any institutional control enters; on that fixed sample no control moves it materially. The earlier draft's ``65\% attenuation by state history'' was therefore $\approx 91\%$ a sample-composition effect and only $\approx 9\%$ conditioning.}}{33}{table.caption.22}\protected@file@percent }
\newlabel{tab:colonial-partial-extended}{{14}{33}{DARC coefficient on log GDPpc 2015 under sample restriction and progressive control additions. The 154-country baseline loading is negative ($-2.65$) but is carried by the 18 countries---predominantly Sub-Saharan African and Gulf states---that lack Bockstette-Putterman state-history coverage. Restricting to the 136 countries for which state history is observed already flips DARC to $+0.62$ ($p=0.67$) \emph {before} any institutional control enters; on that fixed sample no control moves it materially. The earlier draft's ``65\% attenuation by state history'' was therefore $\approx 91\%$ a sample-composition effect and only $\approx 9\%$ conditioning}{table.caption.22}{}}
