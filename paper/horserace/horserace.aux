\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces H\_pred coefficient evolution with full 8-SNP bundle (Exercise a). R\textsuperscript  {2} rises substantially with the functional bundle, but the H\_pred coefficient becomes unstable: the standard error inflates and the sign flips on log GDPpc, characteristic of multicollinearity between H\_pred and the bundle. This is the predicted consequence of two PW-ancestry-weighted measures spanning overlapping continental gradients, not an empirical anomaly.}}{28}{table.caption.16}\protected@file@percent }
\newlabel{tab:h-pred-evolution}{{9}{28}{H\_pred coefficient evolution with full 8-SNP bundle (Exercise a). R\textsuperscript {2} rises substantially with the functional bundle, but the H\_pred coefficient becomes unstable: the standard error inflates and the sign flips on log GDPpc, characteristic of multicollinearity between H\_pred and the bundle. This is the predicted consequence of two PW-ancestry-weighted measures spanning overlapping continental gradients, not an empirical anomaly}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces H\_pred coefficient evolution with PCA-3 bundle (Exercise b). The 8 functional alleles are replaced by their first three principal components (94\% of bundle variance) to remove within-bundle collinearity. On log GDPpc the H\_pred coefficient attenuates cleanly toward zero ($|t|: 3.35 \to 0.63$); on log pop growth attenuation is partial, indicating H\_pred retains some unique signal on the demographic-growth outcome beyond what the bundle captures.}}{28}{table.caption.17}\protected@file@percent }
\newlabel{tab:h-pred-evolution-pca}{{10}{28}{H\_pred coefficient evolution with PCA-3 bundle (Exercise b). The 8 functional alleles are replaced by their first three principal components (94\% of bundle variance) to remove within-bundle collinearity. On log GDPpc the H\_pred coefficient attenuates cleanly toward zero ($|t|: 3.35 \to 0.63$); on log pop growth attenuation is partial, indicating H\_pred retains some unique signal on the demographic-growth outcome beyond what the bundle captures}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Commonality decomposition of joint R\textsuperscript  {2} between H\_pred and the 8-locus functional-allele bundle (Exercise c). On both outcomes the bundle's unique contribution dwarfs $H$'s, and the common (multicollinear) component is small. The bundle is strictly the more informative substrate.}}{29}{table.caption.18}\protected@file@percent }
\newlabel{tab:h-pred-commonality}{{11}{29}{Commonality decomposition of joint R\textsuperscript {2} between H\_pred and the 8-locus functional-allele bundle (Exercise c). On both outcomes the bundle's unique contribution dwarfs $H$'s, and the common (multicollinear) component is small. The bundle is strictly the more informative substrate}{table.caption.18}{}}
